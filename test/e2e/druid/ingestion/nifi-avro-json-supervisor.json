{
  "type": "kafka",
  "spec": {
    "dataSchema": {
      "dataSource": "divolte_nifi_avro_json",
      "timestampSpec": {"column": "timestamp", "format": "millis"},
      "dimensionsSpec": {"useSchemaDiscovery": true},
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "HOUR",
        "queryGranularity": "NONE",
        "rollup": false
      }
    },
    "ioConfig": {
      "topic": "divolte_example_event-json-debug",
      "inputFormat": {"type": "json"},
      "consumerProperties": {"bootstrap.servers": "kafka:9094"},
      "taskCount": 1,
      "replicas": 1,
      "taskDuration": "PT1H",
      "useEarliestOffset": true
    },
    "tuningConfig": {
      "type": "kafka",
      "maxRowsInMemory": 100000,
      "maxRowsPerSegment": 5000000,
      "intermediatePersistPeriod": "PT10M"
    }
  }
}
